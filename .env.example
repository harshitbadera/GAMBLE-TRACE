# Copy to .env or set these values in the deployment environment. Never commit real secrets.
GAMBLETRACE_ENV=production
GAMBLETRACE_SECRET_KEY=replace-with-a-long-random-secret
GAMBLETRACE_INITIAL_SETUP_TOKEN=replace-with-a-one-time-setup-token

# Alternative first-account bootstrap. Set both values, then remove the password
# from the environment after the first successful startup.
# GAMBLETRACE_ADMIN_USERNAME=admin
# GAMBLETRACE_ADMIN_PASSWORD=replace-with-a-strong-password

# Set this only when Flask is deployed behind a trusted reverse proxy.
GAMBLETRACE_TRUSTED_PROXY_COUNT=1
